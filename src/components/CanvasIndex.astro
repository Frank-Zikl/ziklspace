---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props {
  notes: CollectionEntry<'notes'>[];
}
const { notes } = Astro.props;
---

<section
  class="canvas-index shell"
  aria-labelledby="index-title"
  data-note-index
>
  <svg
    class="index-doodle"
    viewBox="0 0 170 115"
    fill="none"
    aria-hidden="true"
  >
    <path d="M17 9c-5 50 53 13 68 36 14 23-35 23-15 47 16 17 44 6 76-8m-11-5 15 3-8 13" />
  </svg>
  <div class="index-side-label">
    <h2 id="index-title">笔记</h2>
    <span class="mono">{String(notes.length).padStart(2, '0')}</span>
    <a href="/notes/" aria-label="全部笔记">
      <Icon name="arrow" size={24} />
    </a>
  </div>
  <div class="index-controls">
    <button type="button" aria-label="上一张笔记" data-index-prev disabled>
      ←
    </button>
    <button type="button" aria-label="下一张笔记" data-index-next>
      →
    </button>
  </div>
  <div class="index-stack" data-index-stack>
    {notes.slice(0, 3).map((note, index) => (
      <a
        class="index-slip"
        href={`/notes/${note.id}/`}
        style={`--slip-order:${index}; --slip-angle:${[-7, 1.5, 8][index]}deg`}
      >
        <span class="slip-hole" aria-hidden="true"></span>
        <div class="slip-meta">
          <span class="mono">{String(index + 1).padStart(2, '0')}</span>
          <span>{note.data.category}</span>
        </div>
        <h3>
          {note.data.title.match(/[^，]+，?/g)?.map((phrase) => (
            <span class="title-phrase">{phrase}</span>
          ))}
        </h3>
        <div class="slip-bottom">
          <time class="mono" datetime={note.data.date}>
            {note.data.date.replaceAll('-', '.')}
          </time>
          {note.data.sample && <span class="sample-marker">样稿</span>}
          <Icon name="arrow" size={16} />
        </div>
      </a>
    ))}
  </div>
  <div class="index-baseline" aria-hidden="true">
    <span>+</span>
    <span>+</span>
  </div>
</section>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-note-index]')
    .forEach((root) => {
      const stack = root.querySelector<HTMLElement>('[data-index-stack]');
      const previous =
        root.querySelector<HTMLButtonElement>('[data-index-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-index-next]');
      if (stack && previous && next) {
        const update = () => {
          previous.disabled = stack.scrollLeft <= 1;
          next.disabled =
            stack.scrollLeft + stack.clientWidth >= stack.scrollWidth - 2;
        };
        const move = (direction: number) =>
          stack.scrollBy({
            left: direction * stack.clientWidth * 0.8,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
              .matches
              ? 'instant'
              : 'smooth',
          });
        previous.addEventListener('click', () => move(-1));
        next.addEventListener('click', () => move(1));
        stack.addEventListener('scroll', update, { passive: true });
        new ResizeObserver(update).observe(stack);
        update();
      }
    });
</script>
