---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Icon from '../../components/Icon.astro';
import { loadNotes, formatDate } from '../../lib/content';
const notes = await loadNotes();
---

<Layout title="笔记">
  <section class="content-shell">
    <PageHeading title="笔记" />
    <div class="collection-label">
      <span>{notes.length} 篇笔记</span>
    </div>
    <div class="notes-index">
      {notes.map((note) => (
        <a class="note-preview" href={`/notes/${note.id}/`}>
          <div class="note-preview-meta">
            <span>{note.data.category}</span>
            <span class="mono">{formatDate(note.data.date)}</span>
          </div>
          <h2>{note.data.title}</h2>

          <div class="note-preview-bottom">
            {note.data.sample ? (
              <span class="sample-marker">样稿</span>
            ) : (
              <span></span>
            )}
            <span>
              阅读 <Icon name="arrow" size={17} />
            </span>
          </div>
        </a>
      ))}
    </div>
    {notes.length === 0 && <span class="empty-label">暂无笔记</span>}
  </section>
</Layout>
