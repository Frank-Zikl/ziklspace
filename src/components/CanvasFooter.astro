---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="canvas-colophon shell">
  <span class="mono">© 2026 / {site.name}</span>
  <a class="canvas-backtop" href="#main" aria-label="回到顶部">
    ↑
  </a>
  <a class="drawer-ticket" href="/play/">
    <span class="ticket-punch" aria-hidden="true"></span>
    <span>小抽屉</span>
    <Icon name="arrow" size={18} />
  </a>
</footer>
