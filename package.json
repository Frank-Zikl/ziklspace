{
  "name": "ziklspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/test-build.mjs && playwright test",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "7.4.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  }
}
